# Copy to .env and fill in. .env is gitignored.
FRED_API_KEY=             # https://fredaccount.stlouisfed.org/apikeys  (free)
SOSOVALUE_API_KEY=        # https://sosovalue.com/developer            (free, 10 req/min, 10k/month)
COINGECKO_DEMO_KEY=       # optional: https://www.coingecko.com/en/api  (free Demo plan)
# Optional Binance host overrides (e.g. when running behind a VPN)
# BINANCE_SPOT_API=https://api.binance.com
# BINANCE_FAPI=https://fapi.binance.com

# Hourly job: ExpressVPN for the Binance step only (see scripts/run_update.sh)
# MDH_VPN_MODE=binance            # off (default) | binance | always
# MDH_VPN_LOCATION="Japan - Tokyo" # a non-US location; list them with: expressvpnctl get regions
